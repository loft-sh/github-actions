@test "homebrew tap -> multiple formula paths all get updated" {
  export INPUT_HOMEBREW_TAP_REPO="example-org/example-tap"
  export INPUT_HOMEBREW_FORMULA_PATHS='["Formula/vcluster.rb","Formula/vcluster-experimental.rb"]'
  set_checksums_fixture "example-org/example-repo" "$FIXTURES_DIR/checksums.txt"
  set_contents_fixture "repos/example-org/example-tap/contents/Formula/vcluster.rb" "$FIXTURES_DIR/vcluster.rb"
  cp "$FIXTURES_DIR/vcluster.rb" "$FIXTURES_DIR/vcluster-experimental.rb"
  set_contents_fixture "repos/example-org/example-tap/contents/Formula/vcluster-experimental.rb" "$FIXTURES_DIR/vcluster-experimental.rb"

  run "$SCRIPT"
  [ "$status" -eq 0 ]
  grep -qF 'API PUT repos/example-org/example-tap/contents/Formula/vcluster.rb sha=fakesha' "$GH_MOCK_CALLS"
  grep -qF 'API PUT repos/example-org/example-tap/contents/Formula/vcluster-experimental.rb sha=fakesha' "$GH_MOCK_CALLS"

  # Assert the second formula's committed body too, not just that a PUT fired -
  # a per-formula loop that diverged for formula #2 (wrong version, URL, or
  # sha256) would otherwise pass undetected.
  put_out="$(put_output_path 'repos/example-org/example-tap/contents/Formula/vcluster-experimental.rb')"
  [ -f "$put_out" ]
  grep -qF 'version "9.9.9"' "$put_out"
  grep -qF 'https://github.com/example-org/example-repo/releases/download/v9.9.9/vcluster-darwin-amd64' "$put_out"
  grep -qF 'https://github.com/example-org/example-repo/releases/download/v9.9.9/vcluster-linux-amd64' "$put_out"
  grep -qF 'sha256 "cccc111111111111111111111111111111111111111111111111111111cccc"' "$put_out"
  grep -qF 'sha256 "dddd222222222222222222222222222222222222222222222222222222dddd"' "$put_out"
}

@test "homebrew tap -> missing checksum for an artifact warns, leaves its sha256 untouched" {
  export INPUT_HOMEBREW_TAP_REPO="example-org/example-tap"
  export INPUT_HOMEBREW_FORMULA_PATHS='["Formula/vcluster.rb"]'
  printf 'cccc111111111111111111111111111111111111111111111111111111cccc  vcluster-darwin-amd64\n' > "$FIXTURES_DIR/checksums-partial.txt"
  set_checksums_fixture "example-org/example-repo" "$FIXTURES_DIR/checksums-partial.txt"
  set_contents_fixture "repos/example-org/example-tap/contents/Formula/vcluster.rb" "$FIXTURES_DIR/vcluster.rb"

  run "$SCRIPT"
  [ "$status" -eq 0 ]
  [[ "$output" == *"no checksum for vcluster-linux-amd64"* ]]

  put_out="$(put_output_path 'repos/example-org/example-tap/contents/Formula/vcluster.rb')"
  grep -qF 'sha256 "cccc111111111111111111111111111111111111111111111111111111cccc"' "$put_out"
  # linux-amd64 had no replacement checksum, so its old sha256 survives.
  grep -qF 'sha256 "bbbb000000000000000000000000000000000000000000000000000000bbbb"' "$put_out"
  grep -qF 'version "9.9.9"' "$put_out"
}

@test "homebrew tap -> rewrites only the top-level version, leaves resource pins untouched" {
  write_fake_formula_with_resource "$FIXTURES_DIR/vcluster.rb"
  export INPUT_HOMEBREW_TAP_REPO="example-org/example-tap"
  export INPUT_HOMEBREW_FORMULA_PATHS='["Formula/vcluster.rb"]'
  set_checksums_fixture "example-org/example-repo" "$FIXTURES_DIR/checksums.txt"
  set_contents_fixture "repos/example-org/example-tap/contents/Formula/vcluster.rb" "$FIXTURES_DIR/vcluster.rb"

  run "$SCRIPT"
  [ "$status" -eq 0 ]

  put_out="$(put_output_path 'repos/example-org/example-tap/contents/Formula/vcluster.rb')"
  # Top-level version bumped; the resource stanza's own version pin preserved.
  grep -qF '  version "9.9.9"' "$put_out"
  grep -qF '    version "1.2.3"' "$put_out"
  [ "$(grep -c 'version "9.9.9"' "$put_out")" -eq 1 ]
  # The resource's unrelated url/sha256 (not a release-download URL) is untouched.
  grep -qF 'url "https://example.com/vendored-lib/1.2.3.tar.gz"' "$put_out"
  grep -qF 'sha256 "eeee000000000000000000000000000000000000000000000000000000eeee"' "$put_out"
}

@test "homebrew tap -> artifact names differing only at a regex metachar keep their own sha256" {
  write_fake_formula_metachar "$FIXTURES_DIR/vcluster.rb"
  write_fake_checksums_metachar "$FIXTURES_DIR/checksums.txt"
  export INPUT_HOMEBREW_TAP_REPO="example-org/example-tap"
  export INPUT_HOMEBREW_FORMULA_PATHS='["Formula/vcluster.rb"]'
  set_checksums_fixture "example-org/example-repo" "$FIXTURES_DIR/checksums.txt"
  set_contents_fixture "repos/example-org/example-tap/contents/Formula/vcluster.rb" "$FIXTURES_DIR/vcluster.rb"

  run "$SCRIPT"
  [ "$status" -eq 0 ]

  put_out="$(put_output_path 'repos/example-org/example-tap/contents/Formula/vcluster.rb')"
  # Each url's following sha256 must be its OWN artifact's checksum. A regex
  # matcher (the `.` in `vcluster-plugin.amd64` matching the `x` in
  # `vcluster-pluginxamd64`) would cross-assign these; a literal one can't.
  run grep -A1 -F 'download/v9.9.9/vcluster-plugin.amd64' "$put_out"
  [[ "$output" == *'sha256 "aaaa333333333333333333333333333333333333333333333333333333aaaa"'* ]]
  run grep -A1 -F 'download/v9.9.9/vcluster-pluginxamd64' "$put_out"
  [[ "$output" == *'sha256 "bbbb444444444444444444444444444444444444444444444444444444bbbb"'* ]]
}

@test "homebrew tap -> formula whose download tag isn't a release version is skipped, not mangled" {
  # The download tag is read from the (tap-committer-controlled) formula and
  # then used as literal data. A tag that isn't a recognizable release version
  # must warn-skip rather than flow into the patch - the guard that also keeps
  # such a value from ever reaching a shell/sed/regex or awk -v escape context.
  cat > "$FIXTURES_DIR/vcluster.rb" <<'RUBY'
class Vcluster < Formula
  version "9.0.0"
  on_macos do
    url "https://github.com/example-org/example-repo/releases/download/not-a-version/vcluster-darwin-amd64"
    sha256 "aaaa000000000000000000000000000000000000000000000000000000aaaa"
  end
end
RUBY
  export INPUT_HOMEBREW_TAP_REPO="example-org/example-tap"
  export INPUT_HOMEBREW_FORMULA_PATHS='["Formula/vcluster.rb"]'
  set_checksums_fixture "example-org/example-repo" "$FIXTURES_DIR/checksums.txt"
  set_contents_fixture "repos/example-org/example-tap/contents/Formula/vcluster.rb" "$FIXTURES_DIR/vcluster.rb"

  run "$SCRIPT"
  [ "$status" -eq 0 ]
  [[ "$output" == *"unrecognized version tag 'not-a-version'"* ]]
  # Advisory skip leaves the formula untouched (same as the "no download URL"
  # skip): the committed body is byte-for-byte the original - version and the
  # unrecognized download tag are both unchanged, nothing was mangled.
  put_out="$(put_output_path 'repos/example-org/example-tap/contents/Formula/vcluster.rb')"
  grep -qF 'version "9.0.0"' "$put_out"
  grep -qF 'download/not-a-version/vcluster-darwin-amd64' "$put_out"
  run ! grep -qF 'download/v9.9.9/' "$put_out"
  [ "$(grep -c '^CREATE ' "$CRANE_MOCK_CALLS")" -eq 6 ]
}
