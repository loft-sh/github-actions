@test "homebrew tap -> oss-repo list failure skips the tap as a retryable warning, not a false backport" {
  # Regression guard: a transient oss-repo list failure (soft) must NOT be
  # collapsed into the confirmed-backport state. The tap is skipped either way,
  # but the operator must see an accurate "could not confirm / retryable"
  # warning instead of a misleading "backport" notice that hides a stale
  # formula on what may be a genuine newest-release promotion.
  export INPUT_HOMEBREW_TAP_REPO="example-org/example-tap"
  export INPUT_HOMEBREW_FORMULA_PATHS='["Formula/vcluster.rb"]'
  set_checksums_fixture "example-org/example-repo" "$FIXTURES_DIR/checksums.txt"
  set_contents_fixture "repos/example-org/example-tap/contents/Formula/vcluster.rb" "$FIXTURES_DIR/vcluster.rb"
  export GH_MOCK_LIST_FAIL_REPO="$INPUT_OSS_REPO"

  run "$SCRIPT"
  [ "$status" -eq 0 ]
  [[ "$output" == *"could not confirm v9.9.9 is the newest stable release on example-org/example-repo"* ]]
  [[ "$output" != *"(backport/patch promotion); skipping Homebrew"* ]]
  # No tap write, no checksums pulled - but everything upstream still ran.
  run ! grep -q '^API PUT\|^DOWNLOAD ' "$GH_MOCK_CALLS"
  [ "$(grep -c '^CREATE ' "$CRANE_MOCK_CALLS")" -eq 6 ]
  grep -qF -- 'EDIT example-org/example-repo v9.9.9 --prerelease=false' "$GH_MOCK_CALLS"
  run ! grep -qF -- '--latest' "$GH_MOCK_CALLS"
}

