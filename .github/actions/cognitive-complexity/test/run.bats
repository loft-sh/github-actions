#!/usr/bin/env bats
# Tests for cognitive-complexity/run.sh
#
# Stubs `gocognit` so we can assert on the files it receives and simulate
# findings, a clean run and a tool error without the real binary.

SCRIPT="$BATS_TEST_DIRNAME/../run.sh"

setup() {
  TEST_DIR=$(mktemp -d)
  export TEST_DIR

  MOCK_DIR="$TEST_DIR/mock"
  mkdir -p "$MOCK_DIR"

  export GITHUB_STEP_SUMMARY="$TEST_DIR/summary"
  : > "$GITHUB_STEP_SUMMARY"
  export THRESHOLD=20
  export IGNORE='(^|/)(vendor|e2e)/|_test\.go$'

  export GOCOGNIT_CALLS="$TEST_DIR/gocognit_calls"
  export GOCOGNIT_OUTPUT="$TEST_DIR/gocognit_output"
  export GOCOGNIT_EXIT="$TEST_DIR/gocognit_exit"
  : > "$GOCOGNIT_CALLS"
  : > "$GOCOGNIT_OUTPUT"
  echo "0" > "$GOCOGNIT_EXIT"

  # Stub gocognit: record each argument on its own line, print
  # GOCOGNIT_OUTPUT, exit with GOCOGNIT_EXIT.
  cat > "$MOCK_DIR/gocognit" <<'MOCK'
#!/usr/bin/env bash
printf '%s\n' "$@" >> "$GOCOGNIT_CALLS"
cat "$GOCOGNIT_OUTPUT"
echo "gocognit: note: recursion may be under-counted" >&2
exit "$(cat "$GOCOGNIT_EXIT")"
MOCK
  chmod +x "$MOCK_DIR/gocognit"
  export GOCOGNIT_BIN="$MOCK_DIR/gocognit"

  SRC_DIR="$TEST_DIR/src"
  mkdir -p "$SRC_DIR/cmd" "$SRC_DIR/pkg" "$SRC_DIR/vendor/dep" "$SRC_DIR/e2e"
  echo 'package main' > "$SRC_DIR/cmd/main.go"
  echo 'package pkg' > "$SRC_DIR/pkg/a.go"
  echo 'package pkg' > "$SRC_DIR/pkg/a_test.go"
  echo 'package dep; func (' > "$SRC_DIR/vendor/dep/broken.go"
  echo 'package e2e' > "$SRC_DIR/e2e/spec.go"
  printf '%s\n' '// Code generated by ent, DO NOT EDIT.' '' 'package pkg' > "$SRC_DIR/pkg/ent.go"
  cd "$SRC_DIR"
}

teardown() {
  rm -rf "$TEST_DIR"
}

# Helper: the sorted files gocognit received, without the -over flag.
gocognit_files() {
  grep -vxE -- '-over|[0-9]+' "$GOCOGNIT_CALLS" | sort
}

@test "findings: exits 0 and writes them highest first to the summary" {
  printf '%s\n' "25 pkg a a.go:1:1" "140 pkg b b.go:1:1" "31 pkg c c.go:1:1" > "$GOCOGNIT_OUTPUT"
  echo "1" > "$GOCOGNIT_EXIT"

  run "$SCRIPT"

  [ "$status" -eq 0 ]
  expected=$(printf '%s\n' \
    "### 3 functions with cognitive complexity > 20" \
    '```' \
    "140 pkg b b.go:1:1" \
    "31 pkg c c.go:1:1" \
    "25 pkg a a.go:1:1" \
    '```')
  [ "$(cat "$GITHUB_STEP_SUMMARY")" = "$expected" ]
}

@test "no findings: writes a zero count without a code block" {
  run "$SCRIPT"

  [ "$status" -eq 0 ]
  [ "$(cat "$GITHUB_STEP_SUMMARY")" = "### 0 functions with cognitive complexity > 20" ]
}

@test "tool error: fails the step when gocognit exits non-zero with no findings" {
  echo "1" > "$GOCOGNIT_EXIT"

  run "$SCRIPT"

  [ "$status" -eq 1 ]
  [[ "$output" == *"::error::gocognit failed"* ]]
}

@test "ignored and generated files never reach gocognit" {
  run "$SCRIPT"

  [ "$status" -eq 0 ]
  [ "$(head -n2 "$GOCOGNIT_CALLS")" = "$(printf '%s\n' -over 20)" ]
  [ "$(gocognit_files)" = "$(printf '%s\n' cmd/main.go pkg/a.go)" ]
}

@test "empty IGNORE still skips generated files" {
  export IGNORE=""

  run "$SCRIPT"

  [ "$status" -eq 0 ]
  expected=$(printf '%s\n' cmd/main.go e2e/spec.go pkg/a.go pkg/a_test.go vendor/dep/broken.go | sort)
  [ "$(gocognit_files)" = "$expected" ]
}

@test "scans only the given paths" {
  export SCAN_PATHS="./cmd"

  run "$SCRIPT"

  [ "$status" -eq 0 ]
  [ "$(gocognit_files)" = "cmd/main.go" ]
}

@test "overlapping scan paths pass each file once" {
  export SCAN_PATHS=". ./pkg pkg"

  run "$SCRIPT"

  [ "$status" -eq 0 ]
  [ "$(gocognit_files)" = "$(printf '%s\n' cmd/main.go pkg/a.go)" ]
}

@test "fails when a scan path is missing, even next to a valid one" {
  export SCAN_PATHS="./pkg ./missing"

  run "$SCRIPT"

  [ "$status" -eq 1 ]
  [[ "$output" == *"::error::cannot read every scan path in './pkg ./missing'"* ]]
  [ ! -s "$GOCOGNIT_CALLS" ]
}

@test "fails when no Go files are left after exclusions" {
  export SCAN_PATHS="./vendor ./e2e"

  run "$SCRIPT"

  [ "$status" -eq 1 ]
  [[ "$output" == *"::error::no Go files left to scan"* ]]
  [ ! -s "$GOCOGNIT_CALLS" ]
}

@test "requires THRESHOLD" {
  unset THRESHOLD

  run "$SCRIPT"

  [ "$status" -ne 0 ]
  [[ "$output" == *"THRESHOLD is required"* ]]
}
